<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.HelloController">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="⚔️ BATTLE ADVENTURE"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TabPane VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE">

        <!-- CHARACTER SELECTION -->
        <Tab text="Character">
            <BorderPane>
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <center>
                    <VBox alignment="CENTER" spacing="12">
                        <Label text="🦸 Your Character"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                        <ImageView fitWidth="240"
                                   fitHeight="240"
                                   preserveRatio="true"/>

                        <Label text="Character description appears here."
                               wrapText="true"
                               maxWidth="280"/>

                        <Label text="Health: 100 | Attack: 10"/>
                    </VBox>
                </center>

                <right>
                    <VBox spacing="12" prefWidth="250">
                        <Label text="Choose Your Hero"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <ComboBox promptText="Select character"
                                  maxWidth="Infinity"/>

                        <Label text="Available Characters"/>

                        <ListView prefHeight="250">
                            <placeholder>
                                <Label text="Character choices"/>
                            </placeholder>
                        </ListView>

                        <Button text="Confirm Character"
                                maxWidth="Infinity"/>
                    </VBox>
                </right>
            </BorderPane>
        </Tab>

        <!-- BATTLE -->
        <Tab text="Battle">
            <BorderPane>
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>

                <center>
                    <VBox alignment="CENTER" spacing="15">
                        <Label text="⚔️ THE ARENA"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                        <HBox alignment="CENTER" spacing="20">
                            <VBox alignment="CENTER" spacing="10">
                                <Label text="🦸 Your Hero"
                                       style="-fx-font-weight: bold;"/>

                                <ImageView fitWidth="160"
                                           fitHeight="160"
                                           preserveRatio="true"/>

                                <Label text="Health: 100 / 100"/>
                                <Label text="Hero description"
                                       wrapText="true"
                                       maxWidth="180"/>
                            </VBox>

                            <Label text="VS"
                                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                            <VBox alignment="CENTER" spacing="10">
                                <Label text="👹 Enemy"
                                       style="-fx-font-weight: bold;"/>

                                <ImageView fitWidth="160"
                                           fitHeight="160"
                                           preserveRatio="true"/>

                                <Label text="Health: 100 / 100"/>
                                <Label text="Enemy description"
                                       wrapText="true"
                                       maxWidth="180"/>
                            </VBox>
                        </HBox>

                        <Button text="Confirm Action"
                                prefWidth="200"
                                prefHeight="40"/>
                    </VBox>
                </center>

                <right>
                    <VBox spacing="7" prefWidth="220">
                        <Label text="⚔️ Attacks"
                               style="-fx-font-weight: bold;"/>

                        <ListView prefHeight="85">
                            <placeholder>
                                <Label text="Available attacks"/>
                            </placeholder>
                        </ListView>

                        <Label text="🗡️ Weapons"
                               style="-fx-font-weight: bold;"/>

                        <ListView prefHeight="75">
                            <placeholder>
                                <Label text="Available weapons"/>
                            </placeholder>
                        </ListView>

                        <Label text="🎒 Items"
                               style="-fx-font-weight: bold;"/>

                        <ListView prefHeight="75">
                            <placeholder>
                                <Label text="Available items"/>
                            </placeholder>
                        </ListView>

                        <Label text="📜 Battle Log"
                               style="-fx-font-weight: bold;"/>

                        <ListView prefHeight="130"
                                  VBox.vgrow="ALWAYS">
                            <placeholder>
                                <Label text="Battle events"/>
                            </placeholder>
                        </ListView>
                    </VBox>
                </right>
            </BorderPane>
        </Tab>

        <!-- SHOP -->
        <Tab text="Shop">
            <BorderPane>
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <center>
                    <VBox alignment="CENTER" spacing="12">
                        <Label text="🛒 Item Preview"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                        <ImageView fitWidth="240"
                                   fitHeight="240"
                                   preserveRatio="true"/>

                        <Label text="Selected item name"
                               style="-fx-font-size: 18px;"/>

                        <Label text="Item description appears here."
                               wrapText="true"
                               maxWidth="300"/>

                        <Label text="Price: 50 gold"/>
                    </VBox>
                </center>

                <right>
                    <VBox spacing="10" prefWidth="260">
                        <Label text="🏪 Shop Inventory"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <Label text="💰 Gold: 100"/>

                        <ListView prefHeight="300">
                            <placeholder>
                                <Label text="Available items"/>
                            </placeholder>
                        </ListView>

                        <Button text="Confirm Purchase"
                                maxWidth="Infinity"/>

                        <Label text="Your Inventory"/>

                        <ListView prefHeight="150">
                            <placeholder>
                                <Label text="Items you own"/>
                            </placeholder>
                        </ListView>
                    </VBox>
                </right>
            </BorderPane>
        </Tab>

        <!-- MAP -->
        <Tab text="Map">
            <BorderPane>
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <center>
                    <VBox alignment="CENTER" spacing="12">
                        <Label text="🗺️ World Map"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                        <ImageView fitWidth="450"
                                   fitHeight="350"
                                   preserveRatio="true"/>

                        <Label text="Explore locations throughout your adventure."
                               wrapText="true"
                               maxWidth="350"/>
                    </VBox>
                </center>

                <right>
                    <VBox spacing="10" prefWidth="250">
                        <Label text="📍 Destinations"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <ListView prefHeight="280">
                            <placeholder>
                                <Label text="Available locations"/>
                            </placeholder>
                        </ListView>

                        <Label text="Location Details"/>

                        <Label text="Select a location to see its description."
                               wrapText="true"/>

                        <Button text="Confirm Destination"
                                maxWidth="Infinity"/>

                        <Label text="Visited Locations"/>

                        <ListView prefHeight="140">
                            <placeholder>
                                <Label text="Your journey so far"/>
                            </placeholder>
                        </ListView>
                    </VBox>
                </right>
            </BorderPane>
        </Tab>

    </TabPane>

    <Label text="✨ Welcome, adventurer!"/>

</VBox>
