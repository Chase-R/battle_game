<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12"
      style="-fx-background-color: #18201f; -fx-font-family: 'Arial';"
      xmlns="http://javafx.com/javafx/19"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.HelloController">

    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <Label text="⚔️ KINGDOMS BENEATH"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

    <TabPane fx:id="tabPane"
             tabClosingPolicy="UNAVAILABLE"
             VBox.vgrow="ALWAYS"
             style="-fx-background-color: #26312f;">

        <!-- CHARACTER SELECTION -->
        <Tab fx:id="ctab" text="Character">
            <BorderPane style="-fx-background-color: #202a28;">
                <padding>
                    <Insets top="22" right="22" bottom="22" left="22"/>
                </padding>

                <center>
                    <VBox alignment="CENTER" spacing="18"
                          style="-fx-background-color: #2b3834; -fx-background-radius: 16; -fx-border-color: #927548; -fx-border-radius: 16; -fx-border-width: 1.5;">
                        <padding>
                            <Insets top="22" right="22" bottom="22" left="22"/>
                        </padding>

                        <Label text="CHOOSE YOUR MOLE-RAT"
                               style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #f0d69b;"/>

                        <HBox alignment="CENTER" spacing="16">

                            <VBox alignment="CENTER" spacing="10">
                                <ImageView fitHeight="145" fitWidth="145" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../images/mrat1.jpg"/>
                                    </image>
                                </ImageView>
                                <Button fx:id="ib1" mnemonicParsing="false" onAction="#iselct" text="Select"
                                        style="-fx-background-color: #987443; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox alignment="CENTER" spacing="10">
                                <ImageView fitHeight="145" fitWidth="145" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../images/mrat2.jpg"/>
                                    </image>
                                </ImageView>
                                <Button fx:id="ib2" mnemonicParsing="false" onAction="#iselct" text="Select"
                                        style="-fx-background-color: #987443; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox alignment="CENTER" spacing="10">
                                <ImageView fitHeight="145" fitWidth="145" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../images/mrat3.jpg"/>
                                    </image>
                                </ImageView>
                                <Button fx:id="ib3" mnemonicParsing="false" onAction="#iselct" text="Select"
                                        style="-fx-background-color: #987443; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox alignment="CENTER" spacing="10">
                                <ImageView fitHeight="145" fitWidth="145" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../images/mrat4.jpg"/>
                                    </image>
                                </ImageView>
                                <Button fx:id="ib4" contentDisplay="CENTER" mnemonicParsing="false" onAction="#iselct" text="Select"
                                        style="-fx-background-color: #987443; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            </VBox>

                        </HBox>

                        <Label text="BUILD YOUR CHARACTER"
                               style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #f0d69b;"/>

                        <HBox alignment="CENTER" spacing="35">
                            <VBox alignment="CENTER" spacing="8">
                                <Label fx:id="attacklbl" text="Attack"
                                       style="-fx-font-size: 15px; -fx-text-fill: white;"/>
                                <Button mnemonicParsing="false" onAction="#AddAttack" text="Attack +1"
                                        style="-fx-background-color: #9a573e; -fx-text-fill: white;"/>
                            </VBox>

                            <VBox alignment="CENTER" spacing="8">
                                <Label fx:id="defenselbl" text="Defense"
                                       style="-fx-font-size: 15px; -fx-text-fill: white;"/>
                                <Button mnemonicParsing="false" onAction="#addDefense" text="Defense +1"
                                        style="-fx-background-color: #496d65; -fx-text-fill: white;"/>
                            </VBox>
                        </HBox>

                        <TextField fx:id="nametxt" promptText="Enter your character's name"
                                   maxWidth="300"
                                   style="-fx-background-radius: 8; -fx-padding: 9;"/>

                        <Button mnemonicParsing="false" onAction="#onConfirmCharacter" text="Begin Adventure"
                                prefWidth="220" prefHeight="40"
                                style="-fx-background-color: #b18a4c; -fx-text-fill: #18201f; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8;"/>

                    </VBox>
                </center>
            </BorderPane>
        </Tab>

        <!-- BATTLE -->
        <Tab fx:id="btab" text="Battle">
            <BorderPane style="-fx-background-color: #202a28;">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <center>
                    <VBox alignment="CENTER" spacing="18">

                        <Button fx:id="BTMbtn" mnemonicParsing="false" onAction="#backToMap"
                                text="Back to Map" visible="false"/>

                        <Label text="THE ARENA"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                        <HBox alignment="CENTER" spacing="34">

                            <VBox alignment="CENTER" spacing="12"
                                  style="-fx-background-color: #2b3834; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #496d65; -fx-border-radius: 14;">
                                <Label text="YOUR HERO"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                                <ImageView fx:id="playerImage" fitHeight="190" fitWidth="190" preserveRatio="true"/>

                                <Label fx:id="playerHealthLabel" text="Health: 100 / 100"
                                       style="-fx-font-weight: bold; -fx-text-fill: #a8d7a1;"/>

                                <Label fx:id="playerDescriptionLabel" maxWidth="190" text="Hero description"
                                       wrapText="true" style="-fx-text-fill: white;"/>
                            </VBox>

                            <Label text="VS"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                            <VBox alignment="CENTER" spacing="12"
                                  style="-fx-background-color: #2b3834; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #9a573e; -fx-border-radius: 14;">
                                <Label fx:id="enemyname" text="Enemy"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                                <ImageView fx:id="enemyImage" fitHeight="190" fitWidth="190" preserveRatio="true"/>

                                <Label fx:id="enemyHealthLabel" text="Health: 100 / 100"
                                       style="-fx-font-weight: bold; -fx-text-fill: #e5a18c;"/>

                                <Label fx:id="enemyDescriptionLabel" maxWidth="190" text="Enemy description"
                                       wrapText="true" style="-fx-text-fill: white;"/>
                            </VBox>

                        </HBox>

                        <Button fx:id="confirmActionButton" onAction="#onConfirmAction"
                                prefHeight="42" prefWidth="220" text="Confirm Action"
                                style="-fx-background-color: #b18a4c; -fx-text-fill: #18201f; -fx-font-weight: bold; -fx-background-radius: 8;"/>

                    </VBox>
                </center>

                <right>
                    <VBox prefWidth="235" spacing="12"
                          style="-fx-background-color: #2b3834; -fx-background-radius: 12; -fx-padding: 16;">

                        <Label text="⚔️ BATTLE ACTIONS"
                               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                        <Button mnemonicParsing="false" onAction="#handleAttack" text="Attack"
                                maxWidth="Infinity"
                                style="-fx-background-color: #9a573e; -fx-text-fill: white; -fx-font-weight: bold;"/>

                        <Button fx:id="weaponSpecialButton" mnemonicParsing="false" onAction="#special"
                                text="Weapon Special" maxWidth="Infinity"
                                style="-fx-background-color: #76619a; -fx-text-fill: white; -fx-font-weight: bold;"/>

                        <Label text="Weapons" style="-fx-font-weight: bold; -fx-text-fill: white;"/>

                        <Label text="Items" style="-fx-font-weight: bold; -fx-text-fill: white;"/>

                        <ListView fx:id="battleItemsListView" prefHeight="110">
                            <placeholder>
                                <Label text="Available items"/>
                            </placeholder>
                        </ListView>

                        <Label text="Battle Log"
                               style="-fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                        <ListView fx:id="battleLogListView" prefHeight="170" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <Label text="Battle events"/>
                            </placeholder>
                        </ListView>

                        <Button mnemonicParsing="false" onAction="#handleAttack" text="Attack"
                                maxWidth="Infinity"
                                style="-fx-background-color: #9a573e; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    </VBox>
                </right>
            </BorderPane>
        </Tab>

        <!-- SHOP -->
        <Tab fx:id="stab" text="Shop">
            <BorderPane style="-fx-background-color: #202a28;">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <top>
                    <VBox alignment="CENTER" spacing="10"
                          style="-fx-background-color: #2b3834; -fx-background-radius: 14; -fx-padding: 14;">

                        <Button mnemonicParsing="false" onAction="#backToMap" text="Back To Map"
                                style="-fx-background-color: #496d65; -fx-text-fill: white;"/>

                        <ImageView fx:id="shopItemImage" fitHeight="210" fitWidth="850" preserveRatio="true">
                            <image>
                                <Image url="@../../../images/Naked Mole-Rat Burrow Shop.png"/>
                            </image>
                        </ImageView>

                        <Label fx:id="shopGoldLabel" text="Gold: 100"
                               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                        <Label fx:id="shopItemDescriptionLabel" maxWidth="500"
                               text="          Arrows can be used to pre-attack enemys" wrapText="true"
                               style="-fx-text-fill: white;"/>

                    </VBox>
                </top>

                <center>
                    <HBox alignment="TOP_CENTER" spacing="18">

                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #2b3834; -fx-background-radius: 12; -fx-padding: 14;">
                            <Label text="WEAPONS"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                            <ListView fx:id="shopItemsListView1" prefHeight="220" VBox.vgrow="ALWAYS">
                                <placeholder>
                                    <Label fx:id="weaponslst" text="Available weapons"/>
                                </placeholder>
                            </ListView>

                            <Button fx:id="confirmPurchaseButton1" maxWidth="Infinity"
                                    onAction="#onConfirmPurchasew" prefHeight="38"
                                    text="Confirm Weapon Purchase"
                                    style="-fx-background-color: #987443; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </VBox>

                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #2b3834; -fx-background-radius: 12; -fx-padding: 14;">
                            <Label text="ITEMS"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                            <ListView fx:id="shopItemsListView" prefHeight="220" VBox.vgrow="ALWAYS">
                                <placeholder>
                                    <Label text="Available items"/>
                                </placeholder>
                            </ListView>

                            <Button fx:id="confirmPurchaseButton" maxWidth="Infinity"
                                    onAction="#onConfirmPurchase" prefHeight="38"
                                    text="Confirm Item Purchase"
                                    style="-fx-background-color: #496d65; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </VBox>

                    </HBox>
                </center>

                <bottom>
                    <VBox spacing="8"
                          style="-fx-background-color: #2b3834; -fx-background-radius: 12; -fx-padding: 12;">

                        <Label text="YOUR INVENTORY"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                        <ListView fx:id="ownedItemsListView" prefHeight="105">
                            <placeholder>
                                <Label text="Items you own"/>
                            </placeholder>
                        </ListView>

                    </VBox>
                </bottom>
            </BorderPane>
        </Tab>

        <!-- MAP -->
        <Tab fx:id="mtab" text="Map">
            <BorderPane style="-fx-background-color: #202a28;">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <center>
                    <VBox alignment="CENTER" spacing="10">

                        <Label text="UNDERGROUND WORLD MAP"
                               style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                        <ImageView fitHeight="390" fitWidth="1050" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../images/map.png"/>
                            </image>
                        </ImageView>

                    </VBox>
                </center>

                <bottom>
                    <HBox spacing="16" prefHeight="230">

                        <VBox prefWidth="390" spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #2b3834; -fx-background-radius: 12; -fx-padding: 14;">

                            <Label text="📍 DESTINATIONS"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                            <ListView fx:id="locationsListView" VBox.vgrow="ALWAYS">
                                <placeholder>
                                    <Label text="Available locations"/>
                                </placeholder>
                            </ListView>

                            <Button fx:id="confirmDestinationButton" maxWidth="Infinity"
                                    onAction="#onConfirmDestination" text="Confirm Destination"
                                    style="-fx-background-color: #b18a4c; -fx-text-fill: #18201f; -fx-font-weight: bold;"/>

                        </VBox>

                        <VBox prefWidth="390" spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #2b3834; -fx-background-radius: 12; -fx-padding: 14;">

                            <Label text="INVENTORY / LOCATION DETAILS"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #e6c27a;"/>

                            <Label fx:id="locationDetailsLabel"
                                   text="If you have an arrow in your inventory you will automatically deal 5 damage to the opponent"
                                   wrapText="true" style="-fx-text-fill: white;"/>

                            <ListView fx:id="visitedLocationsListView" VBox.vgrow="ALWAYS">
                                <placeholder>
                                    <Label text="Inventory"/>
                                </placeholder>
                            </ListView>

                        </VBox>

                    </HBox>
                </bottom>
            </BorderPane>
        </Tab>

        <!-- YOU LOSE -->
        <Tab fx:id="ltap" text="you lose">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0"
                            style="-fx-background-color: #171b1b;">
                    <children>
                        <ImageView fitHeight="747.0" fitWidth="806.0" layoutX="4.0" layoutY="128.0"
                                   pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../images/Defeated Mole-Rat_ You Lose!.png"/>
                            </image>
                        </ImageView>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <!-- YOU WIN -->
        <Tab fx:id="wtap" text="you win">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0"
                            style="-fx-background-color: #171b1b;">
                    <children>
                        <ImageView fitHeight="719.0" fitWidth="789.0" layoutX="14.0" layoutY="14.0"
                                   pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../images/Crowned Mole-Rat Victory Underground.png"/>
                            </image>
                        </ImageView>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

    </TabPane>
</VBox>
